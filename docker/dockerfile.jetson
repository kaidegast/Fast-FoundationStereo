# Fast-FoundationStereo on NVIDIA Jetson Orin (ARM64).
#
# The default image is NVIDIA's Jetson-compatible PyTorch container for
# JetPack 6.2. Build this image *on the Jetson*, never on an x86 host.
#
# For another JetPack release, select an NVIDIA PyTorch container that is
# explicitly compatible with that release, for example:
#   docker build --build-arg BASE_IMAGE=nvcr.io/nvidia/pytorch:<tag> ...
ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.03-py3
FROM ${BASE_IMAGE}

# PyTorch in NVIDIA's framework image links to HPC-X UCC. Put the matching
# UCX first, before any Jetson host library mounted by the NVIDIA runtime;
# otherwise UCC can fail with ucs_config_doc_nop.
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LD_LIBRARY_PATH=/opt/hpcx/ucx/lib:/opt/hpcx/ucc/lib:${LD_LIBRARY_PATH}

# TensorRT and CUDA are supplied by the NVIDIA JetPack/PyTorch image and made
# available to the container by the NVIDIA container runtime. Do not install
# x86 CUDA, TensorRT, PyTorch, torchvision, xformers, or Miniconda here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libgl1 \
    libglib2.0-0 \
    libusb-1.0-0 \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.jetson.txt /tmp/requirements.jetson.txt
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install -r /tmp/requirements.jetson.txt

WORKDIR /workspace

# Fail early if a non-CUDA PyTorch image was selected. Docker build stages do
# not reliably receive the Jetson GPU, so torch.cuda.is_available() is checked
# after `docker run`, not here. TensorRT is needed only for TRT commands.
RUN python3 -c "import torch; assert torch.version.cuda is not None, 'Selected base image has no CUDA-enabled PyTorch'; print('PyTorch:', torch.__version__); print('CUDA:', torch.version.cuda)"
